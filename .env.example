# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat-completions endpoint works (GitHub Models was retired on 2026-07-30).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to false if the provider rejects response_format={"type": "json_object"}.
LLM_JSON_MODE=true
OSDU_NAMESPACE=volve
LLM_TIMEOUT_S=600
# Optional, e.g. "none" turns off thinking on Ollama reasoning models (much faster).
LLM_REASONING_EFFORT=
