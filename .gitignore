# Python / tool caches (recreated automatically)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets
.env

# Downloaded Volve data (licence: don't redistribute; use scripts/download_data.sh)
data/raw/

# LLM response cache
.cache/

# Run outputs, except the committed example run (JSON + review only; bulk Parquet stays local)
outputs/*
!outputs/example/
outputs/example/**/bulk/

# Private notes (application, outreach) - local only
docs/private/
